conda_name=upterm

# uptermd (see compose.yml) — copy this file to .env and adjust as needed.
# All of these are optional; uptermd runs fine with none of them set.

# Restrict who may host a session through this relay to specific SSH public
# keys, authorized_keys-file style (one `ssh-ed25519 AAAA...`/`ssh-rsa
# AAAA...` line per key). Leave unset to allow any key to host, matching
# tmate.io's own open model — verified in server/sshproxy.go: a nil
# authorized-keys list disables the gate entirely.
# UPTERMD_AUTHORIZED_KEYS=/path/to/authorized_keys

# Enable PROXY protocol v1/v2 on the SSH listener — only needed if uptermd
# sits behind a TCP-mode reverse proxy/load balancer (e.g. Traefik, HAProxy,
# AWS ELB) that needs to preserve the real client IP. Leave false for a
# directly-exposed port 2222.
# UPTERMD_SSH_PROXY_PROTOCOL=true